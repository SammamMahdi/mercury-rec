# ---------------------------------------------------------------------------
# MercuryRec environment configuration
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.
# Every key is read by mercury_rec.config.settings.Settings (prefix MERCURY_).
#
# Model and pipeline hyperparameters are NOT here — they live in configs/*.yaml
# so experiments stay reproducible from the repository alone. Rule of thumb:
# if it changes a metric it goes in YAML; if it changes where the process
# connects, it goes here.
# ---------------------------------------------------------------------------

MERCURY_ENVIRONMENT=local
MERCURY_DEBUG=false

# --- API -------------------------------------------------------------------
MERCURY_API_HOST=0.0.0.0
MERCURY_API_PORT=8000

# Keep at 1 on Windows. Each uvicorn worker is a separate `spawn` process that
# re-loads the full model bundle, so raising this exhausts RAM on a 16 GB box
# well before it improves throughput.
MERCURY_API_WORKERS=1

MERCURY_CORS_ORIGINS=["http://localhost:3000"]
MERCURY_MAX_REQUEST_BYTES=1048576

# Enables the `as_of` query parameter used by the frontend's User Journey
# replay. Leave false anywhere that is not a local or demo environment.
MERCURY_ALLOW_AS_OF_OVERRIDE=true

# --- PostgreSQL ------------------------------------------------------------
# Docker Compose brings this up as service `postgres`; from the host use
# localhost. Change the password before exposing this anywhere.
MERCURY_POSTGRES_DSN=postgresql+psycopg://mercury:mercury@localhost:5432/mercury_rec
MERCURY_DB_POOL_SIZE=10
MERCURY_DB_MAX_OVERFLOW=5
MERCURY_DB_ECHO=false

# --- Redis -----------------------------------------------------------------
MERCURY_REDIS_DSN=redis://localhost:6379/0
MERCURY_CACHE_ENABLED=true
MERCURY_CACHE_TTL_SECONDS=300
MERCURY_CACHE_SOFT_TTL_SECONDS=120
MERCURY_CACHE_JITTER_RATIO=0.15

# --- MLflow ----------------------------------------------------------------
# A database-backed store is required for the model registry; a bare file://
# path cannot register models, and file URIs on Windows have a long history of
# drive-letter and backslash bugs. SQLite is the correct local choice.
MERCURY_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MERCURY_MLFLOW_EXPERIMENT=mercury-rec

# --- Data ------------------------------------------------------------------
MERCURY_RANDOM_SEED=42
MERCURY_KAGGLE_DATASET=retailrocket/ecommerce-dataset

# Kaggle credentials are read from ~/.kaggle/kaggle.json by default.
# Set these only if you prefer environment variables. Never commit real values.
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# --- Native runtime --------------------------------------------------------
# Intra-op thread budget shared across PyTorch, LightGBM and FAISS. Pinned
# before any native library loads; see mercury_rec.core._runtime.
MERCURY_NUM_THREADS=8

# Do NOT enable. It silences the duplicate-OpenMP abort without resolving the
# underlying ABI conflict, and can yield silently incorrect numerics.
# KMP_DUPLICATE_LIB_OK=TRUE
